            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/owned-accounts",
            "body": {
              "mode": "raw",
              "raw": "{\"bank\":\"BCA\",\"account_number\":\"1234567890\",\"label\":\"Synthetic account\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const j=pm.response.json(); pm.expect(j.masked_identifier).to.match(/\\*+7890$/); pm.expect(JSON.stringify(j)).not.to.include(\"1234567890\");"
                ]
              }
            }
          ]
        },
        {
          "name": "List owned accounts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/owned-accounts"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().items).to.be.an(\"array\");"
                ]
              }
            }
          ]
        }
      ]
    },
